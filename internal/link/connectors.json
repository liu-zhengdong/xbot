[
  {
    "id": "fetch",
    "title": "网页抓取",
    "summary": "打开网址，把网页内容读成文字。",
    "category": "dev",
    "transport": "stdio",
    "command": "uvx",
    "args": ["mcp-server-fetch"],
    "secret_envs": []
  },
  {
    "id": "playwright",
    "title": "Playwright",
    "summary": "让 Bot 在独立浏览器里点击、填表、截图，适合测试网页。",
    "category": "dev",
    "transport": "stdio",
    "command": "npx",
    "args": ["-y", "@playwright/mcp@latest"],
    "secret_envs": []
  },
  {
    "id": "context7",
    "title": "Context7",
    "summary": "查最新的开发库文档和示例代码。",
    "category": "dev",
    "transport": "stdio",
    "command": "npx",
    "args": ["-y", "@upstash/context7-mcp"],
    "secret_envs": ["CONTEXT7_API_KEY"]
  },
  {
    "id": "localhttp",
    "title": "本机服务",
    "summary": "连接本机上运行的一个服务。地址和口令需要自己准备，不在商店里展示。",
    "transport": "http",
    "url": "http://127.0.0.1:18779/mcp",
    "secret_envs": ["MCP_TOKEN"],
    "hidden": true
  }
]
